// Typechecks the site's own scripts as the browser runs them: classic scripts sharing one global scope,
// and the ES module the full Intro loads.
// It lives outside js/ so that only the site's files are published.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // TypeScript 7 is strict by default. Stated so an editor bundling an older TypeScript checks as strictly.
    "strict": true,
    "skipLibCheck": true,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    // The Intro's 3D scene is an ES module importing "three", which the page's import map points at the
    // copy in js/vendor/three/. Resolved like a bundler would, "three" finds its types in @types/three.
    "module": "esnext",
    "moduleResolution": "bundler",
    // No Node types, so a site script that uses a Node global such as `process` fails the check.
    // TypeScript 7 leaves them out by default; an older TypeScript includes them unless told this.
    "types": []
  },
  "include": ["js/*.js"]
}
